    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const r = item.json;\n  const ok = r.ai_status === 'SUCCESS';\n\n  let budget = 'unknown';\n  if (ok && r.budget_status === 'stated') {\n    const range = r.budget_max && r.budget_max !== r.budget_min\n      ? `${r.budget_min}-${r.budget_max}` : `${r.budget_min}`;\n    budget = `${r.budget_currency || ''} ${range} (${r.budget_period})`.trim();\n  } else if (ok) {\n    budget = r.budget_status;\n  }\n\n  const body = [\n    `Priority: ${r.priority}`,\n    `Services: ${ok ? r.services : 'not available'}`,\n    `Budget: ${budget}`,\n    `Urgency: ${ok ? r.urgency : 'unknown'}`,\n    `Company: ${r.company || 'not provided'}`,\n    `Email: ${r.email}`,\n    `Source: ${r.source}`,\n    '',\n    `Summary: ${ok ? r.summary : 'AI qualification failed. Manual review required.'}`,\n    '',\n    'Original message:',\n    r.message,\n    '',\n    `Lead ID: ${r.id}`\n  ].join('\\n');\n\n  return { json: { id: r.id, subject: `New lead (resent): ${r.name} (${r.priority})`, body } };\n});"
      },
